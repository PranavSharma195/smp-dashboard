# Copy to .env (optional). The app runs fine without any of these.
# Variables are read from the real environment; .env is loaded by run scripts if present.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Illustrative CNY -> NPR rate used for seeded data and defaults. NOT a live rate.
SMP_FX_CNY_TO_NPR=18.5
# Illustrative default import duty/tax percentage for new products. NOT a verified customs rate.
SMP_DEFAULT_DUTY_PCT=15
# Demo account (created by `python manage.py ensure_demo_user`). Change before any deployment!
SMP_DEMO_USERNAME=manab
# SMP_DEMO_PASSWORD=choose-a-strong-password   (optional; otherwise the built-in demo hash is used)
